#include<bits/stdc++.h>
using namespace std;
_int128 climb(int n)
{
    if(n<=2)
    {
        return n;
    }
    vector<_int128>dp(n+1);
    dp[1]=1;    
    dp[2]=2;
    for(int i=3;i<=n;i++)
    {
        dp[i]=dp[i-1]+dp[i-2];
    }   
    return dp[n];
}
int main()
{
    int n;
    cout<<"Enter the number of stairs: ";
    cin>>n;
    _int128 k=climb(n);
    cout<<"The number of ways to climb "<<n<<" stairs is: "<<k<<endl;       
    return 0;
}
