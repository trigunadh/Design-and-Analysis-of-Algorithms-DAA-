#include<bits/stdc++.h>
using namespace std;
_int128 fib(int n)
{
    if(n<=1)
    return n;
    vector<int>dp(n+1);
    dp[0]=0;
    dp[1]=1;
    for(int i=2;i<=n;i++)
    {
        dp[i]=dp[i-1]+dp[i-2];
    }
    return dp[n];
}
int main()
{
    int n;
    cout<<"Enter the number of terms: ";
    cin>>n;
    int k=fib(n);
    cout<<"The "<<n<<"th Fibonacci number is: "<<k<<endl;       
    return 0;
}
