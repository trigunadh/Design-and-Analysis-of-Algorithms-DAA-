#include <bits/stdc++.h>
using namespace std;

int n, m;
vector<vector<char>> board;
string word;

bool search(int i, int j, int k)
{
    if (k == word.size())
        return true;

    if (i < 0 || j < 0 || i >= n || j >= m ||
        board[i][j] != word[k])
        return false;

    char temp = board[i][j];
    board[i][j] = '#';  // Mark visited

    bool found = search(i + 1, j, k + 1) ||
                 search(i - 1, j, k + 1) ||
                 search(i, j + 1, k + 1) ||
                 search(i, j - 1, k + 1);

    board[i][j] = temp;  // Backtracking

    return found;
}

int main()
{
    cout << "Enter rows and columns: ";
    cin >> n >> m;

    board.resize(n, vector<char>(m));

    cout << "Enter grid characters:\n";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < m; j++)
            cin >> board[i][j];

    cout << "Enter word: ";
    cin >> word;

    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < m; j++)
        {
            if (search(i, j, 0))
            {
                cout << "Word found";
                return 0;
            }
        }
    }

    cout << "Word not found";
    return 0;
}
