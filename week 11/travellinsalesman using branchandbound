#include <bits/stdc++.h>
using namespace std;

int n, cost[10][10];
int visited[10];
int minCost = INT_MAX;

void tsp(int curr, int count, int currCost)
{
    if (count == n && cost[curr][0] > 0)
    {
        minCost = min(minCost, currCost + cost[curr][0]);
        return;
    }

    for (int i = 0; i < n; i++)
    {
        if (!visited[i] && cost[curr][i] > 0)
        {
            int newCost = currCost + cost[curr][i];

            if (newCost < minCost)
            {
                visited[i] = 1;

                tsp(i, count + 1, newCost);

                visited[i] = 0;  // Backtracking
            }
        }
    }
}

int main()
{
    cout << "Enter number of cities: ";
    cin >> n;

    cout << "Enter cost matrix:\n";

    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> cost[i][j];

    visited[0] = 1;

    tsp(0, 1, 0);

    if (minCost == INT_MAX)
        cout << "No Hamiltonian tour exists\n";
    else
        cout << "Minimum travel cost = " << minCost << endl;

    return 0;
}
