#include <bits/stdc++.h>
using namespace std;

int n, m;
int graph[10][10];
int color[10];

bool isSafe(int v, int c)
{
    for (int i = 0; i < n; i++)
    {
        if (graph[v][i] == 1 && color[i] == c)
            return false;
    }
    return true;
}

bool graphColoring(int v)
{
    if (v == n)
        return true;

    for (int c = 1; c <= m; c++)
    {
        if (isSafe(v, c))
        {
            color[v] = c;

            if (graphColoring(v + 1))
                return true;

            color[v] = 0;  // Backtracking
        }
    }

    return false;
}

int main()
{
    cout << "Enter number of vertices and colors: ";
    cin >> n >> m;

    cout << "Enter adjacency matrix:\n";
    for (int i = 0; i < n; i++)
    {
        for (int j = 0; j < n; j++)
            cin >> graph[i][j];
    }

    if (graphColoring(0))
    {
        cout << "Color assignment:\n";
        for (int i = 0; i < n; i++)
            cout << "Vertex " << i << " : Color " << color[i] << endl;
    }
    else
    {
        cout << "No solution exists";
    }

    return 0;
}
